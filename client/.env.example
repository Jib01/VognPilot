# Required AI API Key (comma-separated supported)
GEMINI_API_KEY=your_gemini_api_key_here

# Persistent Quota Database (Free Forever on Neon Serverless PostgreSQL)
# Copy from Neon Console -> Connect -> Connection string
DATABASE_URL=

# Optional Distributed Redis Rate Limiter (Free Forever on Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Rate Limit Policy Overrides (defaults live in src/config/limits.ts)
LIMIT_GUEST_SCAN_WINDOW_MIN=10
LIMIT_GUEST_SCAN_WINDOW=6
LIMIT_GUEST_SCAN_HOUR=15
LIMIT_GUEST_SCAN_DAY=30
LIMIT_GUEST_SCAN_MONTH=250
MAX_DAILY_SCANS=400
MAX_MONTHLY_SCANS=9000
LIMIT_SCHEDULE_ENABLED=false
LIMIT_SCHEDULE_START_UTC=6
LIMIT_SCHEDULE_END_UTC=23
